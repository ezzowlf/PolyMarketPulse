# Read-only by design. Never put a wallet private key into this MVP.

POLYMARKETPULSE_ENV=development
POLYMARKETPULSE_DATABASE_PATH=data/polymarketpulse.db
POLYMARKETPULSE_DEFAULT_PROVIDER=polymarket
POLYMARKETPULSE_SCAN_LIMIT=100
POLYMARKETPULSE_REQUEST_TIMEOUT=20
POLYMARKETPULSE_STORE_UNCHANGED_SNAPSHOTS=false
POLYMARKETPULSE_NEWS_ENABLED=false
POLYMARKETPULSE_TELEGRAM_ENABLED=false

# Filter thresholds applied before scoring/saving markets.
MIN_LIQUIDITY=5000
MIN_VOLUME_24H=1000
# Minimum research score (0-100) required before a market is even considered
# for a Telegram alert. Sending itself still requires
# POLYMARKETPULSE_TELEGRAM_ENABLED=true and --send-alerts.
ALERT_SCORE=70

# Only used if POLYMARKETPULSE_TELEGRAM_ENABLED=true. Leave both empty to
# keep Telegram fully disabled; `telegram-preview` never sends anything
# regardless of these values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI research assistant (OpenAI GPT-5 nano, explains a prediction that the
# statistics engine in prediction.py has already computed — GPT never
# invents or changes probabilities). Disabled by default. The app runs
# completely fine with no key set — /ai/* endpoints return 503, the Research
# page shows a clear "AI not enabled" state and a full rule-based fallback
# explanation, no network calls happen. Never commit a real key here or
# anywhere else in this repo.
POLYMARKETPULSE_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_FALLBACK_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1500
POLYMARKETPULSE_AI_CACHE_TTL_SECONDS=900

# Hard cost guardrails, checked BEFORE every OpenAI call using an estimate,
# and re-checked against actual token usage afterwards (see ai/cost.py).
OPENAI_MAX_COST_PER_ANALYSIS_USD=0.01
OPENAI_MAX_INPUT_TOKENS=10000
OPENAI_DAILY_BUDGET_USD=1.00
